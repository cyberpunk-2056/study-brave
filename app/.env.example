# Copy this file to ".env" for local work. On Vercel, add the same names under Settings -> Environment Variables.
# Never commit the real values.

# --- Database (Supabase) ---------------------------------------------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with the database password you chose when creating the project.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Only for the local test database (npm run db:local, which accepts one connection at a time). Leave out on Supabase.
# DATABASE_POOL_MAX=1

# --- Security ---------------------------------------------------------------------------------------------------
# Long random strings. Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# Shared secret between the website and the Focus Study Desktop app. The SAME value must be in desktop/config.json
# ("appKey") before you build the installer.
DESKTOP_APP_KEY=""

# --- Site address -----------------------------------------------------------------------------------------------
# Used in password-reset and parent-message links. Your Vercel (or custom) address, no trailing slash.
APP_URL="https://your-project.vercel.app"

# --- YouTube ----------------------------------------------------------------------------------------------------
# Google Cloud Console -> YouTube Data API v3 -> API key (restrict it to that API).
YOUTUBE_API_KEY=""

# --- Email (forgot password, unlock codes sent to parent/admin) --------------------------------------------------
# Gmail example: smtp.gmail.com, 587, your address, and an "App password" (not your normal password).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Focus Study <no-reply@example.com>"

# --- First admin account (used only by `npm run seed`, run from your own computer) ---------------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-strong-password"
